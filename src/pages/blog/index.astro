---
import {Header, ShareButton} from 'mee-components';
import {header} from '../../../astro.config.mjs';
import {getCollection} from 'astro:content';
import FormattedDate from '../../components/blog/FormattedDate.astro';
import BlogLayout from '@layouts/blog/BlogLayout.astro';
import slugify from '../../utils/slugify';

const posts = (await getCollection('blog', ({data}) => !data.draft)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf(),
);
---

<BlogLayout title="Blog">
  <main class="w-screen">
    <Header header={header} activePage="blog" location="Blog" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start overflow-hidden pt-25 md:pt-36"
    >
      <article class="flex max-w-7xl flex-col items-center justify-center">
        <section
          class="z-100 mt-10 flex h-full w-screen flex-col items-center justify-center gap-10 md:mt-20 md:gap-20"
        >
          <div
            class="flex max-w-5xl flex-col items-center justify-center gap-4 px-6 transition-opacity duration-500"
          >
            <h1
              class="marker text-center text-4xl font-semibold text-grey-900 lg:text-7xl dark:text-gray-50"
            >
              Mee Blog
            </h1>
            <h3
              class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl dark:text-gray-200"
            >
              New updates, improvements, events, and more
            </h3>
          </div>
        </section>
      </article>
      <section>
        <ul class="mt-10 w-screen max-w-7xl">
          {
            posts.map(async (post) => {
              const {Content} = await post.render();
              const url = `/blog/${slugify(post.data)}`;
              return (
                <li class="relative mb-10 flex w-full items-center justify-center border-t border-grey-200 pt-10">
                  <ShareButton
                    url={url}
                    className="!absolute left-4 top-12 hidden lg:block"
                  >
                    Share article
                  </ShareButton>
                  <div class="flex max-w-3xl flex-col gap-8 px-6">
                    <div>
                      <a
                        href={url}
                        class="inline-block text-lg font-medium text-skin-blog-accent decoration-dashed underline-offset-4 focus-visible:no-underline focus-visible:underline-offset-0"
                      >
                        <h3 class="text-4xl font-semibold text-brand-500 dark:text-brand-300">
                          {post.data.title}
                        </h3>
                      </a>
                      <div>
                        <FormattedDate date={post.data.published} />
                      </div>
                    </div>
                    {post.data.previewImage && (
                      <img src={post.data.previewImage} class="rounded-2xl" />
                    )}
                    <article
                      id="article"
                      role="article"
                      class="prose mx-auto max-w-fit text-grey-900 dark:text-gray-200"
                    >
                      {post.data.description ? (
                        post.data.description.map((descriptionItem) => (
                          <p set:html={descriptionItem} />
                        ))
                      ) : (
                        <Content />
                      )}
                    </article>
                    {post.data.description && (
                      <a
                        href={url}
                        class="text-brand-500 underline underline-offset-4 dark:text-brand-300"
                      >
                        Read more
                      </a>
                    )}
                    <ShareButton url={url} className="block lg:hidden">
                      Share article
                    </ShareButton>
                  </div>
                </li>
              );
            })
          }
        </ul>
      </section>
    </section>
  </main>
</BlogLayout>
