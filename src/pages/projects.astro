---
import {Header, Footer} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '../layouts/Layout.astro';
import meeBrowserProduct from '../../public/images/projects/mee-browser.png';
import meeBrowserProductDark from '../../public/images/projects/mee-browser-dark.png';
import privateAdvertisingProduct from '../../public/images/projects/private-advertising.png';
import privateAdvertisingProductDark from '../../public/images/projects/private-advertising-dark.png';
import MdnProduct from '../../public/images/projects/mdn.png';
import MdnProductDark from '../../public/images/projects/mdn-dark.png';
import MdnWebProduct from '../../public/images/projects/mdn-web.png';
import MdnWebProductDark from '../../public/images/projects/mdn-web-dark.png';

const mdnProjectTitle = 'Mee';
const mdnProjectSubtile = 'Profile Sharing';
const mdnProjectDescription =
  'Control the personal information you share with other people and companies';

const projects = [
  {
    image: MdnProduct,
    imageDark: MdnProductDark,
    title: mdnProjectTitle,
    subtitle: mdnProjectSubtile,
    description: mdnProjectDescription,
    comingSoon: false,
    linkTitle: 'Learn more',
    link: 'https://mdn.mee.foundation',
  },
  {
    image: privateAdvertisingProduct,
    imageDark: privateAdvertisingProductDark,
    title: 'Private Advertising',
    subtitle: 'Surveillance-free advertising',
    description:
      'Enabling internet advertising that is tailored to your interests without relying on cookies, tracking and surveillance.',
    comingSoon: false,
    linkTitle: 'Learn more',
    link: 'https://private-advertising.mee.foundation',
  },
  {
    image: meeBrowserProduct,
    imageDark: meeBrowserProductDark,
    title: 'Mee Browser',
    subtitle: 'A browser for the private web',
    description:
      "A browser for both traditional websites as well as meesites where you don't have to create accounts, login, or provide any personally identifying information.",
    comingSoon: true,
    linkTitle: 'Learn more',
    link: 'https://browser.mee.foundation',
  },
];

const mdnProject = {
  image: MdnWebProduct,
  imageDark: MdnWebProductDark,
  title: mdnProjectTitle,
  subtitle: mdnProjectSubtile,
  description: mdnProjectDescription,
  comingSoon: false,
  linkTitle: 'Learn more',
  link: 'https://mdn.mee.foundation',
};
---

<Layout title="Mee Foundation - Projects">
  <main class="w-screen">
    <Header header={header} activePage="projects" location="Projects" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start overflow-hidden bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-273.5 flex-col items-center justify-center gap-4"
      >
        <section
          class="flex h-auto w-screen flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div class="mb-8">
            <h1
              class="mt-13 text-center text-4xl font-bold lg:mt-13 lg:text-7xl dark:text-grey-50"
            >
              Human-centered projects
            </h1>
          </div>
          <section
            class="relative flex w-full flex-col items-center px-10 animation-delay-800"
          >
            <p
              class="text-center text-xl text-grey-800 animation-delay-800 dark:text-grey-300"
            >
              Projects we're working on to create a human-centered user
              experience for the internet.
            </p>
          </section>
        </section>

        <section
          class="flex h-auto flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div>
            <a
              class="mx-8 hidden rounded-2xl border border-grey-300 hover:border-brand-300 hover:shadow-3-strong lg:flex dark:border-grey-600 dark:hover:bg-dark-hover-gradient"
              href={mdnProject.link}
            >
              <div class="relative w-full">
                <img
                  src={mdnProject.image.src}
                  class="h-full w-full rounded-2xl pt-2 lg:pt-0 dark:hidden"
                />
                <img
                  src={mdnProject.imageDark.src}
                  class="hidden h-full w-full rounded-2xl pt-2 lg:pt-0 dark:block"
                />
                <div
                  class="absolute left-4 top-4 flex w-120 flex-col gap-2 p-4"
                >
                  <div
                    class="w-full text-xs font-semibold uppercase text-grey-500 dark:text-grey-200"
                  >
                    {mdnProject.subtitle}
                  </div>
                  <div
                    class="flex w-full items-center gap-2 text-center text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50"
                  >
                    {mdnProject.title}
                    {
                      mdnProject.comingSoon && (
                        <span class="rounded-md border border-grey-200 bg-grey-50 px-2 py-0.5 text-sm lg:text-base dark:text-gray-950">
                          Coming soon
                        </span>
                      )
                    }
                  </div>
                  <div
                    class="w-full text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300"
                  >
                    {mdnProject.description}
                  </div>
                  <div
                    class="flex items-center gap-2.5 text-brand-700 lg:pt-4 dark:text-brand-300"
                  >
                    <span class="underline">{mdnProject.linkTitle}</span>
                    <i class="bi bi-arrow-right"></i>
                  </div>
                </div>
              </div>
            </a>
            <div
              class="flex flex-col items-center justify-center gap-8 p-8 lg:grid lg:grid-cols-2"
            >
              {
                projects.map((project) =>
                  project.comingSoon ? (
                    <div class="h-full max-w-125 rounded-2xl border border-grey-300 pb-8 first:lg:hidden dark:border-grey-600">
                      <img
                        src={project.image.src}
                        class="w-full rounded-t-2xl dark:hidden"
                      />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full rounded-t-2xl dark:block"
                      />
                      <div class="flex flex-col gap-2 p-8 pb-4">
                        <div class="text-xs font-semibold uppercase text-grey-500 dark:text-grey-200">
                          {project.subtitle}
                        </div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50">
                          {project.title}
                          <span class="whitespace-normal rounded-md border border-grey-200 bg-grey-50 px-2 py-0.5 text-sm lg:text-base dark:border-grey-800 dark:bg-grey-900 dark:text-gray-300">
                            Coming soon
                          </span>
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300">
                          {project.description}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <a
                      class="h-full max-w-125 rounded-2xl border border-grey-300 pb-8 hover:border-brand-300 hover:shadow-3-strong first:lg:hidden dark:border-grey-600 dark:hover:bg-dark-hover-gradient"
                      href={project.link}
                    >
                      <img
                        src={project.image.src}
                        class="w-full rounded-t-2xl dark:hidden"
                      />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full rounded-t-2xl dark:block"
                      />
                      <div class="flex flex-col gap-2 p-8 pb-4">
                        <div class="text-xs font-semibold uppercase text-grey-500 dark:text-grey-200">
                          {project.subtitle}
                        </div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50">
                          {project.title}
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300">
                          {project.description}
                        </div>
                      </div>
                      <div class="flex items-center gap-2.5 px-8 py-0.5 text-brand-700 dark:text-brand-300">
                        <span class="underline">{project.linkTitle}</span>
                        <i class="bi bi-arrow-right" />
                      </div>
                    </a>
                  ),
                )
              }
            </div>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>
