---
import {Header, Footer} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '../layouts/Layout.astro';
import meeBrowserProduct from '../assets/projects/browser.png';
import meeBrowserProductDark from '../assets/projects/browser-dark.png';
import smartwalletImage from '../assets/projects/smartwallet.png';
import smartwalletDarkImage from '../assets/projects/smartwallet-dark.png';
import extensionImage from '../assets/projects/extension.png';
import extensionImageDark from '../assets/projects/extension-dark.png';
import webAppImage from '../assets/projects/web-app.png';
import webAppDarkImage from '../assets/projects/web-app-dark.png';

const projects = [
    {
    image: extensionImage,
    imageDark: extensionImageDark,
    title: "Browser Extension",
    label: "v1.2 released",
    description: "Working in conjunction with a Mee-compatible advertising network implements private advertising.",
    link: "https://private-advertising.mee.foundation",
  },
  {
    image: webAppImage,
    imageDark: webAppDarkImage,
    title: "Web App",
    label: "Under development",
    description: "Mee puts you in control of your profile sharing connections to companies and other people. At any time, you can stop them from getting further updates, prevent them from sharing your information, and even automatically delete the data they have about you. Your information is never stored or monetized by The Mee Foundation.",
    link: "https://mdn.mee.foundation/"
  },
  {
    image: smartwalletImage,
    imageDark: smartwalletDarkImage,
    title: "Smartwallet",
    label: "Under development",
    description: "Bring the convenience of profile sharing to your phone. Mee integrates with Apple Contacts, and automatically updates them if your friend or colleague is a Mee user. The Mee smartwallet stores a copy of all of your information on your phone. Nothing is ever shared without your explicit consent.",
    link: "https://smartwallet.mee.foundation/",
  },
  {
    image: meeBrowserProduct,
    imageDark: meeBrowserProductDark,
    title: "Mee Browser",
    label: "Coming Soon",
    description: "Our roadmap includes web browser that combines the functionality of a traditional web browser with a smartwallet. Still just an idea we’re thinking about.",
    comingSoon: true,
    link: "https://browser.mee.foundation",
  },
];
---

<Layout title="Mee Foundation - Projects">
  <main class="w-screen">
    <Header header={header} activePage="projects" location="Projects" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start overflow-hidden bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-273.5 flex-col items-center justify-center gap-4"
      >
        <section
          class="flex h-auto w-screen flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div class="mb-8">
            <h1
              class="mt-13 text-center text-4xl font-bold lg:mt-13 lg:text-7xl dark:text-grey-50"
            >
              Human-centered products
            </h1>
          </div>
          <section
            class="relative flex w-full flex-col items-center px-10 animation-delay-800"
          >
            <p
              class="text-center text-xl text-grey-800 animation-delay-800 dark:text-grey-300"
            >
              We’re working on a human-centered user experience for the internet.
            </p>
          </section>
        </section>

        <section
          class="flex h-auto flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div>
            <div
              class="grid grid-cols-1 grid-rows-[repeat(16,minmax(100px,1fr))] xs:grid-rows-[repeat(16,minmax(112px,1fr))] sm:grid-rows-[repeat(16,minmax(125px,1fr))] items-center justify-center gap-8 p-8 lg:grid-cols-2 lg:grid-rows-[repeat(8,minmax(125px,1fr))]"
            >
              {
                projects.map((project, index) =>
                  project.comingSoon ? (
                    <div class:list={["flex items-end relative h-full max-w-125 row-span-3 rounded-2xl border border-grey-300 pb-8 dark:border-grey-600", 
                      // index % 4 === 0 && 'row-span-3'
                      index === 1 && 'row-span-5',
                      index === 2 && 'row-span-5',]
                    }>
                      <img
                        src={project.image.src}
                        class="w-full absolute top-0 left-0 rounded-t-2xl dark:hidden"
                        alt={project.title.split(' ').join('_')}
                      />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full absolute top-0 left-0 rounded-t-2xl dark:block"
                        alt={project.title.split(' ').join('_')}
                      />
                      <div class="flex flex-col gap-2 p-8 pb-0 relative z-1">
                        <div class="text-success-700 dark:text-success-300 text-xs font-semibold -mb-2 uppercase">{project.label}</div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-100">
                          {project.title}
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-200">
                          {project.description}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <a
                      class:list={["flex items-end row-span-3 relative h-full max-w-125 rounded-2xl border border-grey-300 pb-8 hover:border-brand-300 hover:shadow-3-strong dark:border-grey-600 dark:hover:bg-dark-hover-gradient",
                      // index % 4 === 0 && 'row-span-3'
                        index === 1 && 'row-span-5',
                        index === 2 && 'row-span-5',]
                      }
                      href={project.link}
                    >
                      <img
                        src={project.image.src}
                        class="w-full absolute top-0 left-0 rounded-t-2xl dark:hidden"
                        alt={project.title.split(' ').join('_')}
                      />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full absolute top-0 left-0 rounded-t-2xl dark:block"
                        alt={project.title.split(' ').join('_')}
                      />
                      <div class="flex flex-col gap-2 p-8 pb-0 relative z-1">
                        <div class="text-success-700 dark:text-success-300 text-xs font-semibold -mb-2 uppercase">{project.label}</div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-100">
                          {project.title}
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-200">
                          {project.description}
                        </div>
                         <div class="flex items-center gap-2.5 pt-4 pb-0.5 text-brand-700 dark:text-brand-300">
                          <span class="underline">Learn more</span>
                          <i class="bi bi-arrow-right" />
                        </div>
                      </div>
                    </a>
                  ),
                )
              }
            </div>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>
