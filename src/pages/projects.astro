---
// import Footer from '../components/Footer.astro';
import {Header, Footer} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '../layouts/Layout.astro';
import meeBrowserProduct from '../../public/images/projects/mee-browser.png';
import meeBrowserProductDark from '../../public/images/projects/mee-browser-dark.png';
import privateAdvertisingProduct from '../../public/images/projects/private-advertising.png';
import privateAdvertisingProductDark from '../../public/images/projects/private-advertising-dark.png';
import smartwalletProduct from '../../public/images/projects/smartwallet.png';
import smartwalletProductDark from '../../public/images/projects/smartwallet-dark.png';
import virtualAgentProduct from '../../public/images/projects/virtual-agent.png';
import virtualAgentProductDark from '../../public/images/projects/virtual-agent-dark.png';
import providerWalletProduct from '../../public/images/projects/provider-wallet.png';
import providerWalletProductDark from '../../public/images/projects/provider-wallet-dark.png';
import providerWalletMobiProduct from '../../public/images/projects/provider-wallet-mobi.svg';
import providerWalletMobiProductDark from '../../public/images/projects/provider-wallet-mobi-dark.png';

const projects = [
  {
    image: smartwalletProduct,
    imageDark: smartwalletProductDark,
    title: 'Smartwallet',
    subtitle: 'Identity Agent',
    description:
      'Local identity agent app that combines a digital wallet with a “remote control” for your personal data.',
    comingSoon: false,
    linkTitle: 'Discover the smartwallet',
    link: 'https://smartwallet.mee.foundation',
  },
  {
    image: privateAdvertisingProduct,
    imageDark: privateAdvertisingProductDark,
    title: 'Private Advertising',
    subtitle: 'Surveillance-free advertising',
    description:
      'Enabling internet advertising that is tailored to your interests without relying on cookies, tracking and surveillance.',
    comingSoon: false,
    linkTitle: 'Learn more',
    link: 'https://private-advertising.mee.foundation',
  },
  {
    image: meeBrowserProduct,
    imageDark: meeBrowserProductDark,
    title: 'Mee Browser',
    subtitle: 'A browser for the private web',
    description:
      "A browser for both traditional websites as well as meesites where you don't have to create accounts, login, or provide any personally identifying information.",
    comingSoon: true,
    linkTitle: 'Learn more',
    link: 'https://browser.mee.foundation',
  },
  {
    image: virtualAgentProduct,
    imageDark: virtualAgentProductDark,
    title: 'Mee Data Network',
    subtitle: 'Mee Data Network',
    description:
      'A data network of compatible apps/sites where the information held by them is controlled by your identity agent. This agent can be either local (Mee Smartwallet app) or virtual (web-based identity agent [soon at itsmee.org]) hosted by the Foundation.',
    comingSoon: false,
    linkTitle: 'Learn more',
    link: 'https://mdn.mee.foundation',
  },
  {
    image: providerWalletMobiProduct,
    imageDark: providerWalletMobiProductDark,
    imageMobi: providerWalletMobiProduct,
    imageModiDark: providerWalletMobiProductDark,
    title: 'Agent Service',
    subtitle: 'Mee Data Network',
    description:
      'A web service that websites can integrate to interoperate over the Mee Data Network with Mee-compatible sites and identity agents',
    comingSoon: false,
    linkTitle: 'View docs',
    link: 'https://mdn.mee.foundation/docs/',
  },
];

const providerWallet = {
  image: providerWalletProduct,
  imageDark: providerWalletProductDark,
  title: 'Agent Service',
  subtitle: 'Mee Data Network',
  description:
    'A web service that websites can integrate to interoperate over the Mee Data Network of Mee-compatible sites and identity agents',
  comingSoon: false,
  linkTitle: 'View docs',
  link: 'https://mdn.mee.foundation/docs/',
};
---

<Layout title="Mee Foundation - Projects">
  <main class="w-screen">
    <Header header={header} activePage="projects" location="Projects" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-273.5 flex-col items-center justify-center gap-4"
      >
        <section
          class="flex h-auto w-screen flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div class="mb-8">
            <h1
              class="marker mt-13 text-center text-4xl font-bold lg:mt-13 lg:text-7xl dark:text-grey-50"
            >
              <mark>Human-centered</mark> projects
            </h1>
          </div>
          <section
            class="relative flex w-full flex-col items-center px-10 animation-delay-800"
          >
            <p
              class="text-center text-xl text-grey-800 animation-delay-800 dark:text-grey-300"
            >
              Projects we're working on to create a human-centered user
              experience for the internet.
            </p>
          </section>
        </section>

        <section
          class="flex h-auto flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div>
            <div
              class="flex flex-col items-center justify-center gap-8 p-8 lg:grid lg:grid-cols-2"
            >
              {
                projects.map((project) =>
                  project.comingSoon ? (
                    <div class="h-full max-w-125 rounded-2xl border border-grey-300 pb-8 last:lg:hidden dark:border-grey-600">
                      <img src={project.image.src} class="w-full dark:hidden" />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full dark:block"
                      />
                      <div class="flex flex-col gap-2 p-8 pb-4">
                        <div class="text-xs font-semibold uppercase text-grey-500 dark:text-grey-200">
                          {project.subtitle}
                        </div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50">
                          {project.title}
                          <span class="whitespace-normal rounded-md border border-grey-200 bg-grey-50 px-2 py-0.5 text-sm lg:text-base dark:text-gray-950">
                            Coming soon
                          </span>
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300">
                          {project.description}
                        </div>
                      </div>
                    </div>
                  ) : (
                    <a
                      class="h-full max-w-125 rounded-2xl border border-grey-300 pb-8 last:lg:hidden dark:border-grey-600"
                      href={project.link}
                    >
                      <img src={project.image.src} class="w-full dark:hidden" />
                      <img
                        src={project.imageDark.src}
                        class="hidden w-full dark:block"
                      />
                      <div class="flex flex-col gap-2 p-8 pb-4">
                        <div class="text-xs font-semibold uppercase text-grey-500 dark:text-grey-200">
                          {project.subtitle}
                        </div>
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50">
                          {project.title}
                        </div>
                        <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300">
                          {project.description}
                        </div>
                      </div>
                      <div class="flex items-center gap-2.5 px-8 py-0.5 text-brand-700 dark:text-brand-300">
                        <span class="underline">{project.linkTitle}</span>
                        <i class="bi bi-arrow-right" />
                      </div>
                    </a>
                  ),
                )
              }
            </div>
            <a
              class="mx-8 hidden rounded-2xl border border-grey-300 lg:flex"
              href={providerWallet.link}
            >
              <div class="relative w-full">
                <img
                  src={providerWallet.image.src}
                  class="h-full w-full pt-2 lg:pt-0 dark:hidden"
                />
                <img
                  src={providerWallet.imageDark.src}
                  class="hidden h-full w-full pt-2 lg:pt-0 dark:block"
                />
                <div
                  class="absolute left-4 top-4 flex w-120 flex-col gap-2 p-4"
                >
                  <div
                    class="w-full text-xs font-semibold uppercase text-grey-500 dark:text-grey-200"
                  >
                    {providerWallet.subtitle}
                  </div>
                  <div
                    class="flex w-full items-center gap-2 text-center text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50"
                  >
                    {providerWallet.title}
                    {
                      providerWallet.comingSoon && (
                        <span class="rounded-md border border-grey-200 bg-grey-50 px-2 py-0.5 text-sm lg:text-base dark:text-gray-950">
                          Coming soon
                        </span>
                      )
                    }
                  </div>
                  <div
                    class="w-full text-balance text-sm text-grey-800 lg:text-base dark:text-grey-300"
                  >
                    {providerWallet.description}
                  </div>
                  <div
                    class="flex items-center gap-2.5 text-brand-700 lg:pt-4 dark:text-brand-300"
                  >
                    <span class="underline">{providerWallet.linkTitle}</span>
                    <i class="bi bi-arrow-right"></i>
                  </div>
                </div>
              </div>
            </a>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>
