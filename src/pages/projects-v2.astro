---
import {Footer, Header} from 'mee-components';
import {footer, header} from '../../astro.config.mjs';
import extensionImageDark from '../assets/products/extension-dark.png';
import extensionDesktopImageDark from '../assets/products/extension-desktop-dark.png';
import extensionDesktopImage from '../assets/products/extension-desktop.png';
import extensionImage from '../assets/products/extension.png';
import smartwalletDarkImage from '../assets/products/smartwallet-dark.png';
import smartwalletImage from '../assets/products/smartwallet.png';
import webAppDarkImage from '../assets/products/web-app-dark.png';
import webAppImage from '../assets/products/web-app.png';
import Layout from '../layouts/Layout.astro';

const extensionProduct = {
  image: extensionImage,
  imageDark: extensionImageDark,
  imageDesktop: extensionDesktopImage,
  imageDesktopDark: extensionDesktopImageDark,
  title: 'Mee Extension',
  label: 'v1.2 released',
  description: 'Gain some privacy and ease of mind. This extension automatically tells websites you visit not to sell/share your personal information',
  link: 'https://meextension.org/',
};
const products = [
  {
    image: webAppImage,
    imageDark: webAppDarkImage,
    title: 'AgeProtect',
    label: 'Under development',
    description:
      'AgeProtect is a new age verification approach that is opt-in, respects the privacy of all parties, and leaves the existing internet experience unchanged for those that do not opt in.',
    link: 'https://ageprotect.org/',
  },
  {
    image: smartwalletImage,
    imageDark: smartwalletDarkImage,
    title: 'Smartwallet',
    label: 'Under development',
    description:
      'We believe that people have an inalienable right to a digital identity. We secure this right by freely giving everyone their own independent identity–an identity that can never be taken from you by big tech or the government. This identity lives on your phone and/or laptop and is created by a software app called the Mee Smartwallet. The smartwallet manages the storage of your personal data, and allows you to privately share it with people and organizations you trust.',
    link: 'https://itsmee.org/',
  },
];
---

<Layout title="Mee Foundation - Projects">
  <main class="w-screen">
    <Header header={header} activePage="projects" location="Products" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start overflow-hidden bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-[1280px] flex-col items-center justify-center gap-4 pt-8"
      >
        <section
          class="flex h-auto w-full max-w-[930px] flex-col items-center justify-center bg-white px-4 dark:bg-black/90"
        >
          <div class="grid w-full grid-cols-1">
            <a
              class:list={[
                'products__card_gradient relative flex h-[340px] w-full items-end gap-6 rounded-2xl border border-grey-300 hover:border-brand-300 hover:shadow-3-strong xs:h-[400px] sm:h-[520px] md:h-[300px] md:flex-row-reverse md:items-center dark:border-grey-600 dark:hover:bg-dark-hover-gradient',
              ]}
              href={extensionProduct.link}
            >
              <picture class="hidden md:w-1/2 dark:block">
                <source
                  type="image/png"
                  media="(max-width:767px)"
                  srcset={extensionProduct.imageDark.src}
                />
                <source
                  type="image/png"
                  media="(min-width:768px)"
                  srcset={extensionProduct.imageDesktopDark.src}
                />
                <img
                  src={extensionProduct.imageDark.src}
                  class="absolute left-0 top-0 rounded-t-2xl md:relative md:left-[auto] md:right-0 md:w-full"
                  alt={extensionProduct.title}
                  loading="eager"
                  fetchpriority="high"
                />
              </picture>
              <picture class="md:w-1/2 dark:hidden">
                <source
                  type="image/png"
                  media="(max-width:767px)"
                  srcset={extensionProduct.image.src}
                />
                <source
                  type="image/png"
                  media="(min-width:768px)"
                  srcset={extensionProduct.imageDesktop.src}
                />
                <img
                  src={extensionProduct.image.src}
                  class="absolute left-0 top-0 rounded-t-2xl md:relative md:left-[auto] md:right-0 md:w-full"
                  alt={extensionProduct.title}
                  loading="eager"
                  fetchpriority="high"
                />
              </picture>
              <div class="relative z-1 flex flex-col gap-2 p-8 md:w-1/2">
                <div
                  class="-mb-2 text-xs font-semibold uppercase text-success-700 dark:text-success-300"
                >
                  {extensionProduct.label}
                </div>
                <div
                  class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 md:text-2xl dark:text-grey-100"
                >
                  {extensionProduct.title}
                </div>
                <div
                  class="text-balance text-sm text-grey-800 md:text-base dark:text-grey-200"
                >
                  {extensionProduct.description}
                </div>
                <div
                  class="flex items-center gap-2.5 pb-0.5 pt-4 text-brand-700 dark:text-brand-300"
                >
                  <span class="underline">Get it now</span>
                  <i class="bi bi-arrow-right"></i>
                </div>
              </div>
            </a>
          </div>
        </section>
      </article>
      <article
        class="mb-28 flex max-w-[1280px] flex-col items-center justify-center gap-4"
      >
        <div
          class="mb-16 flex h-auto w-screen flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <h1
            class="mb-4 mt-13 text-center text-3xl font-bold text-gray-900 lg:text-5xl dark:text-grey-50"
          >
            Under development
          </h1>
          <div
            class="relative flex w-full flex-col items-center px-10 animation-delay-800"
          >
            <p
              class="text-center text-xl text-grey-800 animation-delay-800 lg:text-2xl dark:text-grey-200"
            >
              Projects we're working on
            </p>
          </div>
        </div>

        <div
          class="flex h-auto flex-col items-center justify-center bg-white dark:bg-black/90"
        >
          <div class="flex flex-wrap items-center gap-8 px-4 md:px-8">
            {
              products.map((project) => (
                <a
                  class:list={[
                    'products__card_gradient relative flex h-[620px] items-end rounded-2xl border border-grey-300 pb-8 hover:border-brand-300 hover:shadow-3-strong xs:h-[740px] md:h-[620px] md:w-[calc(50%-16px)] lg:h-[740px] dark:border-grey-600 dark:hover:bg-dark-hover-gradient',
                  ]}
                  href={project.link}
                >
                  <img
                    src={project.image.src}
                    class="absolute left-0 top-0 w-full rounded-t-2xl dark:hidden"
                    alt={project.title.split(' ').join('_')}
                  />
                  <img
                    src={project.imageDark.src}
                    class="absolute left-0 top-0 hidden w-full rounded-t-2xl dark:block"
                    alt={project.title.split(' ').join('_')}
                  />
                  <div class="relative z-1 flex flex-col gap-2 p-8 pb-0">
                    <div class="-mb-2 text-xs font-semibold uppercase text-success-700 dark:text-success-300">
                      {project.label}
                    </div>
                    <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-100">
                      {project.title}
                    </div>
                    <div class="text-balance text-sm text-grey-800 lg:text-base dark:text-grey-200">
                      {project.description}
                    </div>
                    <div class="flex items-center gap-2.5 pb-0.5 pt-4 text-brand-700 dark:text-brand-300">
                      <span class="underline">Learn more</span>
                      <i class="bi bi-arrow-right" />
                    </div>
                  </div>
                </a>
              ))
            }
          </div>
        </div>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>
