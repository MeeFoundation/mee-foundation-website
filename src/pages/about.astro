---
import {Header, Footer, ButtonLink, Input, Button, Alert} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '@layouts/Layout.astro';
import githubLogo from '../../public/images/github-logo.svg';
import githubLogoLight from '../../public/images/github-logo-light.svg';
import linkedinLogo from '../../public/images/linkedin-logo.svg';
import PatreonIcon from '@components/PatreonIcon.astro';
import Carousel from '@components/Carousel.astro';

const principles = [
  {
    title: 'Human Centered',
    text: 'We follow an architectural pattern for the internet which places you and your Mee software agents at the center of personal data flows. Flows of personal data should always be mediated by your agent and none of your personal data should flow directly from one app/site to another.',
    class: 'col-span-6',
  },
  {
    title: 'User Control and Privacy',
    text: 'We seek to shift as much control as possible over your personal data to you, while complying with applicable law. Your explicitl opt-in must be requested for any processing, and you must have the ability to delegate access to your data to others.',
    class: 'col-span-6',
  },
  {
    title: 'Data Rights and Portability',
    text: "Where personal data must be collected by entities, we promote your ability to access, edit, and delete you data regardless of what entity collects it. These rights enable your Mee software agent to move it freely from one entity to another within the Mee Data Network, as well as to download a copy of it.",
    class: 'col-span-12',
  },
  {
    title: 'Agency',
    text: 'We promote the development of personal, trusted, software identity agents to empower you and work entirely on your behalf.',
    class: 'col-span-4',
  },
  {
    title: 'Autonomy',
    text: 'We believe that you should have and control a digital embodiment of yourself (a Mee software identity agent) that is as independent as possible of administrative authorities.',
    class: 'col-span-4',
  },
  {
    title: 'Decentralization',
    text: 'We promote decentralized architectures where power and control are distributed and not centralized in a few entities or platforms.',
    class: 'col-span-4',
  },
  {
    title: 'Openness and Transparency',
    text: 'We believe in open practices, transparency, and accountability. This principle extends to our organizational practices, governance, and the software we develop. Our software is published on GitHub.',
    class: 'col-span-6',
  },
  {
    title: 'Loyalty',
    text: 'We are a non-profit that works on behalf of you. We have no incentive to make money from your personal data.',
    class: 'col-span-6',
  },
  {
    title: 'Private Advertising',
    text: "We enable apps/sites that earn revenues from advertizing, to continue to do so. However, in contrast to prevailing adtech that relies on tracking you across the web, we are working on private advertising technology which allows ad personalization based on your membership in cohorts with similar interests.",
    class: 'col-span-12',
  },
  {
    title: 'Authorization',
    text: "We require that all service providers' apps/sites that exchange data on the Mee Data Network be authorized by us. They must comply with our UX guidelines and agree to a Mee License agreement that constrains how they manage your personal data so as to maximize your privacy. For example, service providers may not share/sell personal information without your explicit consent. We maintain a public registry of authorized service providers' apps/sites that are allowed to display the Mee trust mark. We enforce this license on behalf of you.",
    class: 'col-span-12',
  },
  {
    title: 'Security',
    text: 'We employ the best security practices in software development and operations.',
    class: 'col-span-6',
  },
  {
    title: 'Inclusivity',
    text: 'We offer our services free of charge. This ensures that everyone has access to, and can participate in, the benefits of control over their personal information regardless of geographic location, socioeconomic status, or preferred technology platform.',
    class: 'col-span-6',
  },
];

const contributors = [
  {
    name: 'Alex Slobodeniuk',
    link: 'https://github.com/AlexSlo-Dev',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {
    name: 'Alex Yuhimenko',
    link: 'https://github.com/alex-swift',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {name: 'Alex Cavalli', link: null, icon: null},
  {
    name: 'Anthony Ivanov',
    link: 'https://github.com/Silenthunt0',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {
    name: 'Anton Matveev',
    link: 'https://github.com/Asfarus1',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {
    name: 'Bogdan Hutuleac',
    link: 'https://www.linkedin.com/in/bogdanhutuleac',
    icon: linkedinLogo,
  },
    {
    name: 'Ainur Saiapov',
    link: 'https://www.linkedin.com/in/asayapow',
    icon: linkedinLogo,
  },
  {
    name: 'Dalkis Muir',
    link: 'https://www.linkedin.com/in/dalkis-muir-a07380a',
    icon: linkedinLogo,
  },
  {
    name: 'Kirill Khalitov',
    link: 'https://github.com/Voronar',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {name: 'Maria Vasyutenko', link: null, icon: null},
  {
    name: 'Paul Trevithick',
    link: 'https://www.linkedin.com/in/paultrevithick',
    icon: linkedinLogo,
    iconDark: githubLogoLight,
  },
  {
    name: 'Pavel Gusev',
    link: 'https://github.com/GusevP',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {
    name: 'Raman Siliuk',
    link: 'https://github.com/siluk007',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {name: 'Rick Lerner', link: null, icon: null},
  {
    name: 'Samaya Habibova',
    link: 'https://www.linkedin.com/in/samayahabibova/',
    icon: linkedinLogo,
  },
  {
    name: 'Sergey Kucherenko',
    link: 'https://github.com/skchrnko',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
  {name: 'Susan Trevithick', link: null, icon: null},
  {name: 'Valeska O’Leary', link: null, icon: null},
  {
    name: 'Wendy Seltzer',
    link: 'https://www.linkedin.com/in/wendyseltzer/',
    icon: linkedinLogo,
  },
  {
    name: 'Xenia Shatalova',
    link: 'https://github.com/ksurmel',
    icon: githubLogo,
    iconDark: githubLogoLight,
  },
];
---

<Layout title="Mee Foundation - About">
  <main class="w-screen">
    <Header header={header} activePage="about" location="About" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start overflow-hidden bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-7xl flex-col items-center justify-center"
      >
        <section
          class="section top-0 z-100 mt-10 flex h-full w-screen flex-col items-center justify-center gap-10 md:mt-20 md:gap-20"
        >
          <div
            class="flex max-w-5xl flex-col items-center justify-center gap-4 px-6 transition-opacity duration-500"
          >
            <h1
              class="text-center text-4xl font-semibold text-grey-900 lg:text-7xl dark:text-grey-50"
            >
              The Mee Foundation
            </h1>
            <h2
              class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl dark:text-grey-200"
            >
              A nonprofit whose mission is to give people more control over their personal data.
            </h2>
          </div>
        </section>
        <div id="mee-principles"></div>
        <section class="flex w-full flex-col items-center justify-center pb-40">
          <div
            class="flex w-full flex-col items-center justify-center gap-4 p-16"
          >
            <h2
              class="max-w-7xl text-3xl font-bold leading-thick text-grey-900 md:text-4xl md:leading-normal lg:text-5xl dark:text-grey-50"
            >
              Our Principles
            </h2>
            <h3
              class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl dark:text-grey-200"
            >
              Here’s what we live by
            </h3>
          </div>
          <div class="max-w-5xl md:max-w-7xl">
            <Carousel items={principles} />
          </div>
        </section>
        <section
          class="relative flex h-auto w-screen flex-col items-center justify-center gap-8 bg-white px-10 animation-delay-800 dark:bg-darky"
        >
          <h2
            class="mt-13 text-3xl font-bold leading-thick md:text-4xl md:leading-normal lg:mt-13 lg:text-5xl dark:text-grey-50"
          >
            Contributors
          </h2>
          <h3
            class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl dark:text-grey-300"
          >
            Coders, admins, writers, legal experts, and more
          </h3>
          <div
            class="flex w-full max-w-7xl flex-wrap items-center justify-center gap-4 pb-25 md:pb-40 xl:gap-6"
          >
            {
              contributors.map((contributor) => {
                if (!contributor.link) {
                  return (
                    <div class="leading flex h-10 w-full max-w-60 items-center justify-between rounded-lg border border-grey-300 px-4 text-center text-base font-semibold leading-tight text-grey-800 sm:w-56 xl:h-12 xl:w-60 dark:border-grey-600 dark:text-grey-300">
                      <p>{contributor.name}</p>
                    </div>
                  );
                }
                return (
                  <a
                    class="leading flex h-10 w-full max-w-60 items-center justify-between rounded-lg border border-grey-300 px-4 text-center text-base font-semibold leading-tight text-grey-800 sm:w-56 xl:h-12 xl:w-60 dark:border-grey-600 dark:text-grey-300"
                    href={contributor.link}
                    target="_blank"
                  >
                    <p class="whitespace-nowrap text-nowrap">
                      {contributor.name}
                    </p>
                    {contributor.icon && (
                      <img
                        src={contributor.icon.src}
                        width="24"
                        height="24"
                        class="h-6 w-6 xl:h-7 xl:w-7 dark:hidden"
                        alt="Decentralized Identity Foundation logo"
                      />
                    )}
                    {contributor.icon && (
                      <img
                        src={contributor.iconDark?.src ?? contributor.icon.src}
                        width="24"
                        height="24"
                        class="hidden h-6 w-6 xl:h-7 xl:w-7 dark:block"
                        alt="Decentralized Identity Foundation logo"
                      />
                    )}
                  </a>
                );
              })
            }
          </div>
          <div
            class="absolute bottom-0 left-0 right-0 h-px w-full bg-header-gradient dark:bg-dark-line-gradient"
          >
          </div>
        </section>
        <section
          class="max-w-7x flex flex-col items-center pb-25 pt-25 md:pb-40 md:pt-40"
        >
          <h2
            class="mb-12 text-3xl font-bold leading-thick md:mb-16 md:text-4xl md:leading-normal lg:text-5xl dark:text-grey-50"
          >
            Our trusted partners
          </h2>
          <div
            class="max-w-7x flex w-screen flex-wrap items-center justify-center gap-6 px-6 lg:gap-16"
          >
            <img
              src="/images/linux-foundation-logo.svg"
              width="179"
              height="60"
              class="w-23.5 md:w-44.75"
              alt="Linux foundation logo"
            />
            <img
              src="/images/open-wallet-logo.svg"
              width="262"
              height="99"
              class="w-34.5 md:w-65.5"
              alt="OpenWallet foundation logo"
            />
            <img
              src="/images/mydata-org-logo.png"
              width="262"
              height="99"
              class="w-34.5 md:w-65.5"
              alt="MyData.org logo"
            />
            <img
              src="/images/dif-logo.png"
              width="165"
              height="56"
              class="w-25 md:w-41.25"
              alt="Decentralized Identity Foundation logo"
            />
          </div>
        </section>
        <section
          id="waitlist"
          class="flex w-screen flex-col gap-16 bg-grey-100 py-20 dark:bg-grey-800"
        >
          <div class="max-w-7x flex w-full flex-col items-center gap-4">
            <h2
              class="text-center text-3xl font-bold leading-thick md:text-4xl md:leading-normal lg:text-5xl dark:text-grey-50"
            >
              Subscribe to our newsletter
            </h2>
            <h3
              class="text max-w-3xl text-pretty px-6 text-center text-xl md:text-2xl dark:text-grey-50"
            >
              Never miss an update with the Mee products
            </h3>
          </div>
          <div
            class="max-w flex w-auto flex-wrap items-start justify-center gap-4 px-6"
            id="email-container"
          >
            <Input
              dataType="email"
              id="email"
              label="Your email"
              leftIcon="envelope"
              size="lg"
              className="max-w-100"
              type="email"
              labelPosition="inside"
            />

            <Button id="subscribe" className="h-14 w-42 text-xl"
              >Subscribe</Button
            >
          </div>
          <div
            class="relative mx-6 -mt-2 flex items-center justify-center md:-mt-5"
          >
            <div class="absolute">
              <Alert
                id="success-alert"
                title="Congrats!"
                icon="envelope-check"
                type="success"
                description="You’ve been subscribed to the Mee Foundation newsletter."
                view="row"
              />
            </div>
            <div class="absolute">
              <Alert
                id="already-alert"
                title="You are already subscribed."
                icon="envelope-check"
                type="secondary"
                description="The email you used is already subscribed."
                view="row"
              />
            </div>
          </div>
        </section>
        <section
          class="section-bg relative -mb-60 flex w-screen flex-col items-center gap-14 px-10 pb-60 text-white animation-delay-800 md:gap-20 lg:gap-24"
        >
          <div class="section-bg-image absolute h-full w-full max-w-7xl"></div>
          <div class="z-70 flex flex-col items-center gap-16">
            <div class="flex flex-col items-center gap-4 pt-40">
              <h2
                class="text-center text-3xl font-bold leading-thick md:text-4xl md:leading-normal lg:text-5xl dark:text-grey-800"
              >
                Support the Mee project
              </h2>
              <h3
                class="text max-w-3xl text-pretty px-6 text-center text-xl md:text-2xl dark:text-grey-800"
              >
                Help us improve and launch more user-centric products and change
                the internet
              </h3>
            </div>
            <div class="mt-8">
              <ButtonLink
                href="https://www.patreon.com/TheMeeFoundation"
                style="filled"
                buttonType="tertiary"
                size="xxl"
                className="w-full"
              >
                <span class="flex items-center gap-2"
                  ><PatreonIcon fill="#334155" />
                  <span>Support on Patreon</span>
                </span></ButtonLink
              >
            </div>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>

<style is:global>
  .section-bg {
    background: linear-gradient(180deg, #0f172a 0%, #334155 81.32%);
  }
  .section-bg-image::after {
    content: '';
    max-width: 80rem;
    width: 100%;
    height: 100%;
    background: url('/images/about/stars.svg') no-repeat;
    position: absolute;
    display: inline-block;
    left: 0;
    top: 3.2rem;
    background-size: 100% 100%;
  }

  .dark .section-bg {
    background: linear-gradient(180deg, #f8fafc 0%, #cbd5e1 81.32%);
  }

  .dark .section-bg-image::after {
    background: url('/images/about/stars-dark.svg') no-repeat;
    background-size: 100% 100%;
  }
</style>

<script>
  import {Validation} from 'mee-components';
  const successAlert = document.getElementById('success-alert');
  const alreadyAlert = document.getElementById('already-alert');
  import {SUBSCRIBE_URL} from '@config';
  const emailContainer = document.getElementById('email-container');
  const emailInput = document.getElementById('email') as HTMLInputElement;

  const inputs = emailContainer?.querySelectorAll('input');
  if (inputs) {
    Validation.addFormListeners(inputs);
  }

  const subscribeButton = document.getElementById(
    'subscribe',
  ) as HTMLButtonElement;
  const subscribeAction = async () => {
    if (inputs) {
      const formValid = Validation.validateForm(inputs);
      if (formValid) {
        const email = emailInput.value;

        const response = await fetch(SUBSCRIBE_URL, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            email: email,
          }),
        });

        if ((response && response.status === 200) || response.status === 409) {
          emailInput.disabled = true;
          emailInput.classList.add('opacity-60');
          subscribeButton.disabled = true;
          response.status === 200 && successAlert?.classList.remove('hidden');
          response.status === 409 && alreadyAlert?.classList.remove('hidden');
        }
      }
    }
  };
  emailInput.onkeydown = function (e) {
    if (e.code === 'Enter') {
      subscribeAction();
    }
  };
  subscribeButton?.addEventListener('click', subscribeAction);
</script>
