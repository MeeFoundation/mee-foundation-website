---
import {Header, Footer, ButtonLink} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '../layouts/Layout.astro';

import brandReputation from '../../public/images/providers/brand-reputation.svg';
import compliance from '../../public/images/providers/compliance.svg';
import consentManagement from '../../public/images/providers/consent-management.svg';
import personalization from '../../public/images/providers/personalization.svg';
import rightsOfData from '../../public/images/providers/rights-of-data.svg';
import superiorUx from '../../public/images/providers/superior-ux.svg';

const offers = [
  {
    image: superiorUx,
    title: 'Superior UX',
    description:
      'No passwords, less form filling, less hassle. Getting data from Mee-friendly sources.',
  },
  {
    image: personalization,
    title: 'Personalization',
    description:
      'Gain access to high-quality, up-to-date opt-in customer profile data.',
  },
  {
    image: brandReputation,
    title: 'Brand reputation',
    description:
      'Enhance your reputation for fair and responsible data practices.',
  },
  {
    image: compliance,
    title: 'Compliance',
    description:
      'Guaranteed compliance with privacy regulations (e.g. GDPR, CCPA).',
  },
  {
    image: rightsOfData,
    title: 'Rights of data',
    description:
      'Respects data subject rights (to access, rectification, erasure, and data portability).',
  },
  {
    image: consentManagement,
    title: 'Consent management',
    description: 'All data sharing events are logged to support audit.',
  },
];
---

<Layout title="Mee Foundation - Businesses">
  <main class="w-screen overflow-hidden">
    <Header header={header} activePage="businesses" location="Businesses" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start bg-white pt-25 md:pt-36"
    >
      <article
        class="mb-28 flex max-w-7xl flex-col items-center justify-center gap-25 md:gap-40"
      >
        <section class="flex flex-col items-center justify-center gap-20">
          <section
            class="z-100 mt-10 flex h-full w-screen flex-col items-center justify-center gap-10 md:mt-20 md:gap-20"
          >
            <div
              class="flex max-w-5xl flex-col items-center justify-center gap-4 px-6 transition-opacity duration-500"
            >
              <h1
                class="marker text-center text-4xl font-semibold text-grey-900 lg:text-7xl"
              >
                Offer the Mee experience
              </h1>
              <h3
                class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl"
              >
                Enhance your website or app with a superior user-centric
                experience
              </h3>
            </div>
          </section>

          <section
            class="flex h-auto max-w-7xl flex-col items-center justify-center bg-white px-4"
          >
            <div class="flex">
              <div class="flex flex-wrap items-stretch justify-center gap-8">
                {
                  offers.map((offer) => (
                    <div class="max-w-96 rounded-2xl border border-grey-300">
                      <img src={offer.image.src} class="w-full" />
                      <div class="flex flex-col gap-2 p-8 pt-0">
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl">
                          {offer.title}
                        </div>
                        <div class="text-balance text-sm tracking-0.02 text-grey-800 lg:text-base">
                          {offer.description}
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
          <section
            class="flex h-auto max-w-7xl flex-col items-center justify-center bg-white"
          >
            <h3
              class="text max-w-4xl text-pretty px-6 text-center text-xl md:text-2xl"
            >
              To incorporate the Mee experience into your websites and apps,
              integrate our Agent Software Development Kit (SDK) or Agent
              Service and agree to the terms of the Mee Data Network License.
            </h3>
          </section>
        </section>

        <section
          class="section-bg relative -mb-60 mt-16 flex w-screen flex-col items-center gap-14 px-10 pb-60 text-white animation-delay-800 md:gap-20 lg:gap-24"
        >
          <div class="section-bg-image absolute h-full w-full max-w-7xl"></div>
          <div class="z-70 flex flex-col items-center gap-16">
            <div class="flex flex-col items-center gap-4 pt-40">
              <h2
                class="text-3xl font-bold leading-thick md:text-4xl md:leading-normal lg:text-5xl"
              >
                Mind your business
              </h2>
              <h3
                class="text max-w-3xl text-pretty px-6 text-center text-xl md:text-2xl"
              >
                We invite businesses to join us in committing to fair and
                responsible data practices that will build trust with people who
                use their apps and sites
              </h3>
            </div>
            <div class="mt-8">
              <ButtonLink
                size="l"
                style="filled"
                buttonType="tertiary"
                href="mailto:contact@mee.foundation">Contact Mee</ButtonLink
              >
            </div>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>

<style>
  .section-bg {
    background: linear-gradient(180deg, #314248 0%, #3b5b64 81.32%);
  }
  .section-bg-image::after {
    content: '';
    max-width: 80rem;
    width: 100%;
    height: 100%;
    background: url('/images/providers/stars.svg') no-repeat;
    position: absolute;
    display: inline-block;
    left: 0;
    top: 0;
    background-size: 100% 100%;
  }
</style>
