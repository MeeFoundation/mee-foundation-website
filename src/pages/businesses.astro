---
import {Header, Footer, ButtonLink} from 'mee-components';
import {header, footer} from '../../astro.config.mjs';
import Layout from '../layouts/Layout.astro';

const offers = [
  {
    image: '/images/providers/superior-ux.png',
    imageDark: '/images/providers/superior-ux-dark.png',
    title: 'Superior UX',
    class: 'col-span-3 dark:bg-grey-950',
    description:
      'Less form filling and administrative hassle for your customers because forms will be pre-filled from your CRM system with their latest data values.',
  },

  {
    image: '/images/providers/customer-acquisition.png',
    imageDark: '/images/providers/customer-acquisition-dark.png',
    title: 'Customer acquisition',
    class: 'col-span-3 dark:bg-grey-950',
    description:
      'Mee’s connection recommendation engine brings you qualified customer prospects.',
  },
  {
    image: '/images/providers/data-quality.png',
    imageDark: '/images/providers/data-quality-dark.png',
    title: 'Data quality',
    class: 'col-span-2',
    description:
      'Gain access to opt-in, accurate, up-to-date “zero party” data directly from your customers.',
  },
  {
    image: '/images/providers/brand-reputation.png',
    imageDark: '/images/providers/brand-reputation-dark.png',
    title: 'Brand reputation',
    class: 'col-span-4 dark:bg-grey-950',
    description:
      'Enhance your reputation for fair and responsible data practices.',
  },
  {
    image: '/images/providers/compliance.png',
    imageDark: '/images/providers/compliance-dark.png',
    title: 'Compliance',
    class: 'col-span-2',
    description:
      'Guaranteed compliance with privacy regulations (e.g. GDPR, CCPA).',
  },
  {
    image: '/images/providers/privacy.png',
    imageDark: '/images/providers/privacy-dark.png',
    title: 'Privacy',
    class: 'col-span-2',
    description:
      'Respect your customers (data subjects) rights to access, rectification, erasure, and data portability.',
  },
  {
    image: '/images/providers/consent-management.png',
    imageDark: '/images/providers/consent-management-dark.png',
    class: 'col-span-2',
    title: 'Consent management',
    description: 'All data sharing events are logged to support audit.',
  },
];
---

<Layout title="Mee Foundation - Businesses">
  <main class="w-screen overflow-hidden">
    <Header header={header} activePage="businesses" location="Businesses" />
    <section
      class="flex h-full w-screen transform-gpu flex-col items-center justify-start bg-white pt-25 md:pt-36 dark:bg-black/90"
    >
      <article
        class="mb-28 flex max-w-7xl flex-col items-center justify-center gap-25 md:gap-40"
      >
        <section class="flex flex-col items-center justify-center gap-20">
          <section
            class="z-100 mt-10 flex h-full w-screen flex-col items-center justify-center gap-10 md:mt-20 md:gap-20"
          >
            <div
              class="flex max-w-7xl flex-col items-center justify-center gap-4 px-6 transition-opacity duration-500"
            >
              <h1
                class="text-center text-4xl font-semibold text-grey-900 lg:text-7xl dark:text-grey-50"
              >
                Benefits for service providers
              </h1>
              <h2
                class="text max-w-3xl text-pretty px-6 text-center text-xl text-grey-900 md:text-2xl dark:text-grey-300"
              >
                Invite your customers to connect with you
              </h2>
            </div>
          </section>

          <section
            class="flex h-auto max-w-7xl flex-col items-center justify-center bg-white px-4 dark:bg-black/90"
          >
            <div class="flex">
              <div
                class="flex flex-wrap items-stretch justify-center gap-8 md:grid md:max-w-max md:grid-cols-6"
              >
                {
                  offers.map((offer) => (
                    <div
                      class:list={[
                        'relative min-h-80 rounded-2xl border border-grey-300 dark:border-grey-600',
                        offer.class,
                      ]}
                    >
                      <img
                        src={offer.image}
                        class="w-full rounded-2xl dark:hidden"
                        alt={offer.title.split(' ').join('_')}
                      />
                      <img
                        src={offer.imageDark}
                        class="hidden w-full rounded-2xl dark:block"
                        alt={offer.title.split(' ').join('_')}
                      />
                      <div class="absolute bottom-0 flex flex-col gap-2 p-8 pt-0">
                        <div class="flex items-center gap-2 whitespace-nowrap text-left text-xl font-semibold text-grey-900 lg:text-2xl dark:text-grey-50">
                          {offer.title}
                        </div>
                        <div class="text-balance text-sm tracking-0.02 text-grey-800 lg:text-base dark:text-grey-300">
                          {offer.description}
                        </div>
                      </div>
                    </div>
                  ))
                }
              </div>
            </div>
          </section>
          <section
            class="flex h-auto max-w-7xl flex-col items-center justify-center bg-white dark:bg-black/90"
          >
            <h3
              class="text max-w-4xl text-pretty px-6 text-center text-xl md:text-2xl dark:text-grey-300"
            >
              To incorporate the Mee experience into your websites and apps,
              integrate our Software Development Kit (SDK) and agree to the
              terms of the Mee Data Network License.
            </h3>
          </section>
        </section>

        <section
          class="section-bg relative -mb-60 mt-16 flex w-screen flex-col items-center gap-14 px-10 pb-60 text-white animation-delay-800 md:gap-20 lg:gap-24"
        >
          <div class="section-bg-image absolute h-full w-full max-w-7xl"></div>
          <div class="z-70 flex flex-col items-center gap-16">
            <div class="flex flex-col items-center gap-4 pt-40">
              <h2
                class="text-3xl font-bold leading-thick md:text-4xl md:leading-normal lg:text-5xl dark:text-grey-800"
              >
                Mind your business
              </h2>
              <h3
                class="text max-w-3xl text-pretty px-6 text-center text-xl md:text-2xl dark:text-grey-800"
              >
                We invite businesses to join us in committing to fair and
                responsible data practices that will build trust with people who
                use their apps and sites
              </h3>
            </div>
            <div class="mt-8">
              <ButtonLink
                size="l"
                style="filled"
                buttonType="tertiary"
                className="h-14 text-xl"
                href="mailto:contact@mee.foundation">Contact Mee</ButtonLink
              >
            </div>
          </div>
        </section>
      </article>
      <Footer footer={footer} mode="dark" />
    </section>
  </main>
</Layout>

<style is:global>
  .section-bg {
    background: linear-gradient(180deg, #314248 0%, #3b5b64 81.32%);
  }
  .section-bg-image::after {
    content: '';
    max-width: 80rem;
    width: 100%;
    height: 100%;
    background: url('/images/providers/stars.svg') no-repeat;
    position: absolute;
    display: inline-block;
    left: 0;
    top: 0;
    background-size: 100% 100%;
  }

  .dark .section-bg {
    background: linear-gradient(180deg, #f8fafc 0%, #cbd5e1 81.32%);
  }

  .dark .section-bg-image::after {
    background: url('/images/providers/stars-dark.svg') no-repeat;
    background-size: 100% 100%;
  }
</style>
