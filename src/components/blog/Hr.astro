---
export interface Props {
  noPadding?: boolean;
  ariaHidden?: boolean;
}

const {noPadding = false, ariaHidden = true} = Astro.props;
---

<div
  class={`max-w-7xl mx-auto flex my-6 h-px border-t w-full border-grey-200 dark:border-gray-700 text-grey-200 ${noPadding ? 'px-0' : 'px-4'}`}
  aria-hidden={ariaHidden}
>
</div>
