---
import FloatingFigures from './FloatingFigures.astro';
import Grid from './Grid.astro';
---

<div
  class="background fixed top-0 h-screen w-screen overflow-hidden"
  id="background"
>
  <Grid />
  <FloatingFigures />
  <div class="shadow"></div>
</div>
<style>
  .background {
    background: radial-gradient(#0d070c, #200e1d);
  }
  .shadow {
    position: absolute;
    top: 0;
    display: flex;
    justify-content: center;
    align-items: center;
    width: 100vw;
    height: 100vh;
    background: radial-gradient(#0f080e 20%, transparent 60%) center no-repeat;
    backface-visibility: hidden;
    transition: all 2s linear;
  }
</style>
