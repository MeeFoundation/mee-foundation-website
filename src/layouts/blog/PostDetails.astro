---
import BlogLayout from '@layouts/blog/BlogLayout.astro';
import {Header} from 'mee-components';
import {header} from '../../../astro.config.mjs';
import Tag from '@components/blog/Tag.astro';
import Datetime from '@components/blog/Datetime';
import type {CollectionEntry} from 'astro:content';
import {slugifyStr} from '@utils/slugify';

export interface Props {
  post: CollectionEntry<'blog'>;
}

const {post} = Astro.props;

const {title, published, tags} = post.data;
// const {title, author, description, ogImage, published, tags} = post.data;

const {Content} = await post.render();

// const ogUrl = new URL(ogImage ? ogImage : `${title}.png`, Astro.url.origin)
//   .href;
---

<BlogLayout title={title}>
  <Header header={header} activePage="blog" location="Blog" />
  <div class="mt-21">
    <div class="mx-auto flex w-full max-w-3xl justify-start px-2">
      <button
        class="focus-outline mb-2 mt-8 flex hover:opacity-75"
        onclick="history.back()"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          class="inline-block h-6 w-6 fill-skin-blog-base group-hover:fill-skin-blog-accent"
          ><path
            d="M13.293 6.293 7.586 12l5.707 5.707 1.414-1.414L10.414 12l4.293-4.293z"
          ></path>
        </svg><span>Go back</span>
      </button>
    </div>
    <main id="main-content" class="text-grey-900 dark:text-gray-200">
      <h1 class="post-title">{title}</h1>
      <Datetime datetime={published} size="lg" className="my-2" />
      <article
        id="article"
        role="article"
        class="prose mx-auto mt-8 max-w-3xl text-grey-900 dark:text-gray-200"
      >
        <Content />
      </article>

      <ul class="tags-container">
        {tags.map((tag) => <Tag name={slugifyStr(tag)} />)}
      </ul>
    </main>
  </div>
  <!-- <Footer /> -->
</BlogLayout>

<style>
  main {
    @apply mx-auto w-full max-w-3xl px-4 pb-12;
  }
  .post-title {
    @apply text-2xl font-semibold text-skin-blog-accent;
  }
  .tags-container {
    @apply my-8;
  }
</style>
