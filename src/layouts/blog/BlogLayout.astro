---
import '@styles/blog.css';
import 'bootstrap-icons/font/bootstrap-icons.css';
import {Footer} from 'mee-components';
import {footer} from '../../../astro.config.mjs';
export interface Props {
  title: string;
}

const {title} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1.0" />
    <meta name="theme-color" content="#ffffff" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />

    <meta
      name="description"
      content="The Mee Foundation is a nonprofit whose mission is to develop a human-centered user experience for the internet."
    />
    <meta
      property="og:title"
      content="A human-centered user experience for the internet"
    />
    <meta
      property="og:description"
      content="The Mee Foundation is a nonprofit whose mission is to develop a human-centered user experience for the internet."
    />
    <meta
      property="og:image"
      content="https://mee.foundation/mee_fav_icon.png"
    />
    <meta
      property="twitter:title"
      content="A human-centered user experience for the internet"
    />
    <meta
      property="twitter:description"
      content="The Mee Foundation is a nonprofit whose mission is to develop a human-centered user experience for the internet"
    />
    <meta
      property="twitter:image"
      content="https://mee.foundation/mee_fav_icon.png"
    />

    <title>{title}</title>
  </head>
  <body>
    <slot />
    <div
      class="max-w-screen mt-10 flex flex-col items-center justify-center overflow-hidden font-sans"
    >
      <Footer footer={footer} mode="dark" />
    </div>
  </body>

  {
    (
      <div
        id="connectionErrAlert"
        class="toast toast-end toast-top z-100 mt-16 hidden"
      >
        <div class="alert alert-error">
          <span>Connection attempt was unsuccessful</span>
        </div>
      </div>
    )
  }
</html>

<style is:global>
  html {
    background-color: #f6f6f6;
    -ms-overflow-style: none;
    scrollbar-width: none;
    --scroll: 0;
    --bleachProgress: 0;
    --bg-offset: 0vh;
    transition: left 1s;
  }
  html::-webkit-scrollbar {
    display: none;
  }
  .logo--contrast > svg {
    fill: #447f88;
  }
</style>
